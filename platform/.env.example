# 模拟参考项目的环境变量驱动配置（Twelve-Factor）。复制为 .env 后修改。

# ===== 检索 =====
SA_TOP_K=5
SA_BM25_POOL=0   # 0=不限制（全库检索）；个人规模下无需截断
SA_USE_VECTOR=true
SA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SA_VECTOR_STORE=sqlite   # sqlite=persistent; linear=in-memory fallback
SA_VECTOR_STORE_PATH=platform/.cache/vector_store.sqlite3
SA_LEARNING_STORE_PATH=platform/.cache/learning_state.sqlite3
# M7-1 独立 Source Registry 控制面；本阶段不会在默认启动路径自动创建。
SA_SOURCE_REGISTRY_PATH=platform/.cache/source_registry.sqlite3
SA_INDEX_CACHE_PATH=platform/.cache/index
# M6a 只支持单进程 / 单 worker。不要设置 WEB_CONCURRENCY、UVICORN_WORKERS 为非 1，也不要设置 SA_INDEX_READONLY。

# ===== 启动期静态额外源（最多 3 个，完整 JSON；root 不写入响应或 manifest） =====
SA_EXTRA_SOURCES=[]
SA_EXTRA_SOURCES_STRICT=true
# 默认包缩减超过 50% 时，必须填写候选包的精确 revision 才允许切换。
SA_EXPECTED_DEFAULT_PACK_REVISION=
# trusted default 可容纳现行 682 chunks；每个 strict extra 仍固定最多 600 chunks。
SA_SOURCE_MAX_CHUNKS_PER_SOURCE=750
SA_SOURCE_MAX_EXTRA_CHUNKS_PER_SOURCE=600
SA_SOURCE_MAX_CHUNKS_TOTAL=1200

# ===== LLM（可选，任一 OpenAI 兼容协议服务均可，不配则问答自动降级为笔记摘要） =====
SA_LLM_BASE_URL=https://api.deepseek.com
SA_LLM_API_KEY=
SA_LLM_MODEL=deepseek-chat

# ===== M6b Agent Preview（默认关闭；与上述 OpenAI-compatible QA 配置完全独立） =====
# 仅当显式启用且 SA_AGENT_PREVIEW_TOKEN 至少含 32 个 UTF-8 字节时注册 POST /api/v1/agent-preview。
# ANTHROPIC_API_KEY 只在服务端使用；缺失时认证后的 preview 返回结构化 503，不影响正式 Search/QA/session。
# 固定官方 Anthropic endpoint、claude-opus-5、adaptive thinking、low effort、native tool use、capacity=2、
# 应用级最多 1 次 retry（SDK max_retries=0）和内存内 allowlist trace；上述政策均不可通过环境变量覆盖。
SA_AGENT_PREVIEW_ENABLED=false
SA_AGENT_PREVIEW_TOKEN=
ANTHROPIC_API_KEY=
# 以下值均为硬上限；如需覆盖只能进一步收紧，不能提高。
SA_AGENT_PREVIEW_DEADLINE_SECONDS=45
SA_AGENT_PREVIEW_MODEL_TIMEOUT_SECONDS=20
SA_AGENT_PREVIEW_TOKEN_COUNT_TIMEOUT_SECONDS=3
SA_AGENT_PREVIEW_TOOL_TIMEOUT_SECONDS=2
SA_AGENT_PREVIEW_MAX_MODEL_TURNS=4
SA_AGENT_PREVIEW_MAX_TOOL_CALLS=3
SA_AGENT_PREVIEW_MAX_INPUT_TOKENS=12000
SA_AGENT_PREVIEW_MAX_OUTPUT_TOKENS=4096
SA_AGENT_PREVIEW_MAX_TURN_OUTPUT_TOKENS=1024
SA_AGENT_PREVIEW_MAX_COST_USD=0.20
SA_AGENT_PREVIEW_MAX_PROMPT_BYTES=8192
SA_AGENT_PREVIEW_MAX_TOOL_RESULT_BYTES=12288
SA_AGENT_PREVIEW_MAX_TOTAL_TOOL_RESULT_BYTES=24576
SA_AGENT_PREVIEW_MAX_ANSWER_BYTES=8192

# ===== 离线演示 =====
# 默认 CI / 一键启动使用 SA_USE_VECTOR=false，不下载 Hugging Face 模型。
# BGE 缓存目录默认 ~/.cache/huggingface（可用 HF_HOME 覆盖）。
# 预下载模型后，可设 HF_HUB_OFFLINE=1 与 TRANSFORMERS_OFFLINE=1 离线启用向量路。
